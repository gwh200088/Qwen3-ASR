# Dockerfile of qwenllm/qwen3-asr:cu128

ARG CUDA_VERSION=12.8.0
ARG from=nvidia/cuda:${CUDA_VERSION}-devel-ubuntu22.04
FROM ${from} as base

ARG DEBIAN_FRONTEND=noninteractive

# CMake 仅 flash-attn 源码编译需要（BUNDLE_FLASH_ATTENTION=false 时跳过下载，
# 同时消除构建期对 github.com 的直连依赖——国内网络直连 github 常超时）
ARG BUNDLE_FLASH_ATTENTION=true

RUN <<EOF
apt update -y && apt upgrade -y && apt install -y --no-install-recommends  \
    git \
    git-lfs \
    python3 \
    python3-pip \
    python3-dev \
    wget \
    vim \
    libsndfile1 \
    ccache \
    software-properties-common \
    ffmpeg \
    ca-certificates \
&& rm -rf /var/lib/apt/lists/*
EOF

RUN if [ "$BUNDLE_FLASH_ATTENTION" = "true" ]; then \
        wget https://github.com/Kitware/CMake/releases/download/v3.26.1/cmake-3.26.1-Linux-x86_64.sh \
            -q -O /tmp/cmake-install.sh \
        && chmod u+x /tmp/cmake-install.sh \
        && mkdir /opt/cmake-3.26.1 \
        && /tmp/cmake-install.sh --skip-license --prefix=/opt/cmake-3.26.1 \
        && rm /tmp/cmake-install.sh \
        && ln -s /opt/cmake-3.26.1/bin/* /usr/local/bin; \
    fi

RUN ln -s /usr/bin/python3 /usr/bin/python

RUN git lfs install

WORKDIR /data/shared/Qwen3-ASR

ENV MAX_JOBS=32
ENV NVCC_THREADS=2
ENV CCACHE_DIR=/root/.cache/ccache

RUN --mount=type=cache,target=/root/.cache/pip \
    pip3 install -U pip setuptools wheel

RUN apt remove python3-blinker -y

# 从本地源码安装（非 PyPI 发布版）——segment 时间戳 + 说话人识别扩展仅存在于本仓库，
# PyPI 的 qwen-asr 不含该功能。依赖（vllm/transformers/pyannote 等）仍从 PyPI 解析。
# torchcodec 版本配对修正：vllm==0.14.0 锁定 torch 2.9.1+cu128，而 pyannote.audio
# 传递依赖的 torchcodec 最新版（0.14+）按 CUDA 13 构建，链接 libnvrtc.so.13，在
# CUDA 12.8 镜像内加载失败（import torchcodec 即 RuntimeError）；0.13.x 是 torch 2.9
# 的官方配对版本（cu128 构建）。pyannote 输入走内存 waveform 字典不依赖其解码器，
# 但保持 torchcodec 可 import 以满足依赖健康检查。
COPY . /data/shared/Qwen3-ASR
RUN --mount=type=cache,target=/root/.cache/pip \
    pip3 install -U "/data/shared/Qwen3-ASR[vllm,diarization]" \
    && pip3 install -U "torchcodec==0.13.*"

# 扩展模型（Qwen3-ForcedAligner-0.6B / pyannote community-1 及其子模型）与 ASR 主模型
# 不打进镜像，统一由运行时挂载 HF_HOME 缓存卷 + 本地模型目录提供，便于离线部署与模型更新：
# - 联网部署：首次请求自动下载（门控模型需 -e HF_TOKEN，先在 hf.co 接受访问条款）
# - 离线部署：预填充缓存卷 + 运行时传 -e HF_HUB_OFFLINE=1 -e TRANSFORMERS_OFFLINE=1，
#   全部模型从本地缓存解析，不发任何网络请求（离线缓存命中无需 token）

RUN --mount=type=cache,target=/root/.cache/ccache \
    --mount=type=cache,target=/root/.cache/pip \
    if [ "$BUNDLE_FLASH_ATTENTION" = "true" ]; then \
        pip3 install -U flash-attn --no-build-isolation git+https://github.com/Dao-AILab/flash-attention.git; \
    fi

RUN rm -rf /root/.cache/pip

EXPOSE 80
